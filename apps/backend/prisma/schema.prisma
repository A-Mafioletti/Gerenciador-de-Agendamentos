generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id            String   @id @default(uuid()) @db.Uuid
  clerk_id      String?  @unique
  email         String   @unique
  nome_completo String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  @@map("clientes")
}
